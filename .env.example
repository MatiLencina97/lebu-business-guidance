# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side Supabase access
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Web Push / VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# Vercel cron protection
CRON_SECRET=generate_a_long_random_value

# Comma-separated accounts allowed to access /admin
LEBU_ADMIN_EMAILS=your-email@example.com

# FUDO integration — server only
# Generate 32 random bytes and store them as base64, e.g. openssl rand -base64 32
FUDO_CREDENTIALS_ENCRYPTION_KEY=
FUDO_AUTH_BASE_URL=https://auth.fu.do/api
FUDO_API_BASE_URL=https://api.fu.do/v1alpha1
FUDO_AUTH_PATH=/login
FUDO_SALES_PATH=/sales
FUDO_SALES_INCLUDE=payments,payments.paymentMethod
